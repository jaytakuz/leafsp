---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-sans-thai/400.css';
import '@fontsource/ibm-plex-sans-thai/500.css';
import '@fontsource/ibm-plex-sans-thai/600.css';
import '@fontsource/ibm-plex-sans-thai/700.css';
import '../styles/global.css';

import type { Lang } from '../i18n/utils';
import { localizePath, stripLocale } from '../i18n/utils';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** English canonical path, e.g. '/services'. Defaults from the URL. */
  canonicalPath?: string;
}
const { lang, title, description } = Astro.props;
const canonicalPath = Astro.props.canonicalPath ?? stripLocale(Astro.url.pathname);

const canonicalUrl = new URL(localizePath(canonicalPath, lang), SITE.url).href;
const enUrl = new URL(localizePath(canonicalPath, 'en'), SITE.url).href;
const thUrl = new URL(localizePath(canonicalPath, 'th'), SITE.url).href;
const ogImage = new URL('/og-image.png', SITE.url).href;
const ogLocale = lang === 'th' ? 'th_TH' : 'en_US';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.companyEn,
  alternateName: SITE.companyTh,
  url: SITE.url,
  logo: new URL('/logo-mark.png', SITE.url).href,
  email: SITE.email,
  telephone: SITE.phoneIntl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '222/92 Nawarat Village, Moo 3, Nong Kaeo',
    addressLocality: 'Hang Dong',
    addressRegion: 'Chiang Mai',
    postalCode: '50230',
    addressCountry: 'TH',
  },
  areaServed: 'TH',
  description:
    'Software and digital production company in Chiang Mai, Thailand — software development, UX/UI, AI & data, QA & security, digital media, and consulting.',
};
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Enables scroll-reveal only when JS is available (content stays visible otherwise) -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Language alternates -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="th" href={thUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#17853a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.companyEn} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={lang === 'th' ? 'en_US' : 'th_TH'}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgSchema)}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-green-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Reveal-on-scroll: adds .is-visible as elements enter the viewport.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
