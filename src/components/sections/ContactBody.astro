---
import type { Lang } from '../../i18n/utils';
import { useTranslations } from '../../i18n/utils';
import { PHONE_COUNTRY_CODES, SITE, WEB3FORMS_ACCESS_KEY } from '../../config';
import Icon from '../Icon.astro';
import ProjectPicker from '../ProjectPicker.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.contactPage.form;
const d = t.contactPage.details;

const address = lang === 'th' ? SITE.addressTh : SITE.addressEn;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  SITE.addressEn
)}`;

// Field chrome without a corner radius, so the phone group can split its
// corners between the dial-code select and the number input.
const fieldCore =
  'border border-border bg-surface px-4 py-3 text-body outline-none transition-colors placeholder:text-muted/70 focus:border-green-400 focus:ring-4 focus:ring-green-100';
const inputBase = `w-full rounded-xl ${fieldCore}`;
const phoneCodeCls = `shrink-0 rounded-l-xl border-r-0 pr-2 ${fieldCore}`;
const phoneNumCls = `w-full rounded-r-xl ${fieldCore}`;
const labelBase = 'mb-1.5 block text-sm font-medium text-text';
---

<section class="relative overflow-hidden border-b border-border bg-surface-soft">
  <div class="grid-bg" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -right-24 -top-28 h-96 w-96 rounded-full bg-lime-400/20 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div class="container-page py-16 md:py-20">
    <div class="reveal is-visible mx-auto max-w-3xl text-center">
      <span class="eyebrow justify-center">{t.contactPage.eyebrow}</span>
      <h1 class="mt-4 text-4xl md:text-5xl">{t.contactPage.title}</h1>
      <p class="mt-5 text-lg text-body">{t.contactPage.subtitle}</p>
    </div>
  </div>
</section>

<section class="bg-surface">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <!-- Form -->
      <div
        class="rounded-3xl border border-border bg-surface p-7 shadow-soft md:p-9"
      >
        <form
          id="contact-form"
          data-access-key={WEB3FORMS_ACCESS_KEY}
          novalidate
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input
            type="hidden"
            name="subject"
            value="New enquiry from leafsp.com"
          />
          <input type="hidden" name="from_name" value="leafsp.com" />
          <!-- honeypot -->
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <ProjectPicker lang={lang} />

          <hr class="mb-8 border-border" />

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class={labelBase} for="cf-name">{f.name}</label>
              <input
                class={inputBase}
                id="cf-name"
                name="name"
                type="text"
                required
                autocomplete="name"
              />
            </div>
            <div>
              <label class={labelBase} for="cf-email">{f.email}</label>
              <input
                class={inputBase}
                id="cf-email"
                name="email"
                type="email"
                required
                autocomplete="email"
              />
            </div>
            <div>
              <label class={labelBase} for="cf-company">
                {f.company}
                <span class="font-normal text-muted">({f.optional})</span>
              </label>
              <input
                class={inputBase}
                id="cf-company"
                name="company"
                type="text"
                autocomplete="organization"
              />
            </div>
            <div>
              <label class={labelBase} for="cf-phone">
                {f.phone}
                <span class="font-normal text-muted">({f.optional})</span>
              </label>
              <div class="flex">
                <select
                  class={phoneCodeCls}
                  id="cf-phone-country"
                  name="phoneCountry"
                  aria-label={f.phoneCountry}
                >
                  {
                    PHONE_COUNTRY_CODES.map((c) => (
                      <option value={c.dial} selected={c.iso === 'TH'}>
                        {c.iso} {c.dial}
                      </option>
                    ))
                  }
                </select>
                <input
                  class={phoneNumCls}
                  id="cf-phone"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  placeholder={f.phonePlaceholder}
                />
              </div>
            </div>
          </div>
          <div class="mt-5">
            <label class={labelBase} for="cf-message">
              {f.message}
              <span class="font-normal text-muted">({f.optional})</span>
            </label>
            <textarea
              class={`${inputBase} min-h-[6rem] resize-y`}
              id="cf-message"
              name="message"
              placeholder={f.messagePlaceholder}></textarea>
          </div>

          <button
            type="submit"
            class="group mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-gradient px-7 py-3.5 text-base font-semibold text-white shadow-[0_16px_40px_-16px_rgba(34,163,69,0.75)] transition-all duration-200 hover:-translate-y-0.5 hover:brightness-[1.04] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 disabled:cursor-not-allowed disabled:opacity-70 sm:w-auto"
            data-submit
          >
            <span data-label>{t.cta.sendMessage}</span>
            <Icon
              name="arrow-right"
              size={18}
              class="transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </button>

          <!-- status -->
          <p
            data-status="success"
            class="mt-4 hidden items-start gap-2 rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800"
          >
            <Icon name="check" size={18} class="mt-0.5 shrink-0 text-green-600" />
            <span>{f.success}</span>
          </p>
          <p
            data-status="error"
            class="mt-4 hidden items-start gap-2 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"
          >
            <span>
              {f.error}
              <a
                href={`mailto:${SITE.email}`}
                class="font-semibold underline">{SITE.email}</a
              >.
            </span>
          </p>

          <!--
            Shown when the Web3Forms key hasn't been configured. The enquiry is
            rendered here for the visitor to copy rather than pushed into a
            mailto: URL — the Thai answers percent-encode to roughly nine
            characters each, so a filled-in form already lands near the ~2048
            character limit and any note would be silently truncated.
          -->
          <div
            data-status="manual"
            class="mt-4 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
          >
            <p class="font-semibold">{f.manualTitle}</p>
            <p class="mt-1">
              {f.manualHint}
              <a
                href={`mailto:${SITE.email}`}
                class="font-semibold underline">{SITE.email}</a
              >
            </p>
            <pre
              data-manual-body
              class="mt-3 max-h-56 overflow-auto whitespace-pre-wrap rounded-lg bg-surface/70 p-3 text-[0.8rem] leading-relaxed text-text"></pre>
            <button
              type="button"
              data-copy
              data-copied={f.copied}
              class="mt-3 inline-flex items-center gap-2 rounded-full border border-amber-300 bg-surface px-4 py-2 text-sm font-semibold text-amber-900 transition-colors hover:bg-amber-100"
            >
              {f.copy}
            </button>
          </div>
        </form>
      </div>

      <!-- Direct details -->
      <div class="rounded-3xl border border-border bg-surface-tint p-7 md:p-9">
        <h2 class="text-xl font-semibold text-text">{d.title}</h2>
        <ul class="mt-6 space-y-6">
          <li class="flex gap-4">
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-surface text-green-600 shadow-soft"
            >
              <Icon name="mail" size={20} />
            </span>
            <div>
              <div class="text-sm font-medium text-muted">{d.email}</div>
              <a
                href={`mailto:${SITE.email}`}
                class="font-medium text-text hover:text-green-700"
              >
                {SITE.email}
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-surface text-green-600 shadow-soft"
            >
              <Icon name="phone" size={20} />
            </span>
            <div>
              <div class="text-sm font-medium text-muted">{d.phone}</div>
              <a
                href={`tel:${SITE.phoneIntl}`}
                class="font-medium text-text hover:text-green-700"
              >
                {SITE.phone}
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-surface text-green-600 shadow-soft"
            >
              <Icon name="map-pin" size={20} />
            </span>
            <div>
              <div class="text-sm font-medium text-muted">{d.office}</div>
              <p class="leading-relaxed text-text">{address}</p>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener"
                class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-green-700 hover:underline"
              >
                Google Maps
                <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-surface text-green-600 shadow-soft"
            >
              <Icon name="clock" size={20} />
            </span>
            <div>
              <div class="text-sm font-medium text-muted">{d.hours}</div>
              <p class="font-medium text-text">{d.hoursValue}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const btn = form.querySelector('[data-submit]') as HTMLButtonElement;
    const label = form.querySelector('[data-label]') as HTMLElement;
    const ok = form.querySelector('[data-status="success"]') as HTMLElement;
    const err = form.querySelector('[data-status="error"]') as HTMLElement;
    const manual = form.querySelector('[data-status="manual"]') as HTMLElement;
    const manualBody = form.querySelector('[data-manual-body]') as HTMLElement;
    const copyBtn = form.querySelector('[data-copy]') as HTMLButtonElement;
    const sendingText = { th: 'กำลังส่ง…', en: 'Sending…' };
    const isTh = document.documentElement.lang === 'th';
    const key = form.getAttribute('data-access-key') || '';

    const show = (el: HTMLElement) => el.classList.replace('hidden', 'flex');
    const hide = (el: HTMLElement) => el.classList.replace('flex', 'hidden');

    // --- Phone field: digits only, grouped as you type -------------------
    const phoneInput = form.querySelector('#cf-phone') as HTMLInputElement | null;
    const phoneCountry = form.querySelector(
      '#cf-phone-country'
    ) as HTMLSelectElement | null;

    // Thai numbers read 081-234-5678 when the trunk zero is typed and
    // 81 234 5678 when it isn't, so the grouping follows what's in the field.
    const groupsFor = (dial: string, digits: string) =>
      dial === '+66'
        ? digits.startsWith('0')
          ? [3, 3, 4]
          : [2, 3, 4]
        : dial === '+1'
          ? [3, 3, 4]
          : [3, 3, 3, 3];

    const groupDigits = (digits: string, dial: string) => {
      const parts: string[] = [];
      let i = 0;
      for (const size of groupsFor(dial, digits)) {
        if (i >= digits.length) break;
        parts.push(digits.slice(i, i + size));
        i += size;
      }
      if (i < digits.length) parts.push(digits.slice(i));
      return parts.join(' ');
    };

    const reformatPhone = () => {
      if (!phoneInput) return;
      const raw = phoneInput.value;
      const dial = phoneCountry?.value || '';
      const dialDigits = dial.replace(/\D/g, '');
      let digits = raw.replace(/\D/g, '');

      // Someone pasting a full international number: drop the country code so
      // the field holds only the national part shown beside the select.
      if (raw.trim().startsWith('+') && dialDigits && digits.startsWith(dialDigits)) {
        digits = digits.slice(dialDigits.length);
      }
      // E.164 caps the whole number at 15 digits, and the dial code is not in
      // this field, so budget for it here.
      digits = digits.slice(0, Math.max(4, 15 - dialDigits.length));

      // Count digits left of the caret so it can be restored to the same spot
      // afterwards instead of jumping to the end of the field.
      const caret = phoneInput.selectionStart ?? raw.length;
      const digitsBeforeCaret = raw.slice(0, caret).replace(/\D/g, '').length;

      const formatted = groupDigits(digits, dial);
      if (formatted !== raw) {
        phoneInput.value = formatted;
        let pos = 0;
        let seen = 0;
        while (pos < formatted.length && seen < digitsBeforeCaret) {
          if (formatted.charCodeAt(pos) >= 48 && formatted.charCodeAt(pos) <= 57) {
            seen++;
          }
          pos++;
        }
        phoneInput.setSelectionRange(pos, pos);
      }
    };

    phoneInput?.addEventListener('input', reformatPhone);
    // Regroup when the country changes, e.g. +66 is 2-3-4 but +1 is 3-3-4.
    phoneCountry?.addEventListener('change', reformatPhone);

    copyBtn?.addEventListener('click', async () => {
      const text = manualBody.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // clipboard API needs a secure context; select the text so Ctrl+C works
        const range = document.createRange();
        range.selectNodeContents(manualBody);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      const original = copyBtn.textContent;
      copyBtn.textContent = copyBtn.getAttribute('data-copied');
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hide(ok);
      hide(err);
      manual.classList.add('hidden');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      // honeypot
      if (data.get('botcheck')) return;

      // Fold the dial code into the number as E.164. Thai numbers are written
      // with a national trunk "0" that must come off first, so 081-234-5678
      // under +66 becomes +66812345678, not +66081234567. A number the
      // visitor already typed in full international form is left alone.
      const dial = (data.get('phoneCountry') || '').toString();
      const typed = (data.get('phone') || '').toString().trim();
      data.delete('phoneCountry');
      data.set(
        'phone',
        !typed
          ? ''
          : typed.startsWith('+')
            ? '+' + typed.replace(/\D/g, '')
            : dial + typed.replace(/\D/g, '').replace(/^0/, '')
      );

      // Fallback: the Web3Forms key hasn't been configured, so nothing can be
      // sent. Show the enquiry for the visitor to copy and leave the form
      // filled in — never report success for a message that didn't go out.
      if (!key || key === 'YOUR_ACCESS_KEY') {
        const body =
          `Name: ${data.get('name')}\n` +
          `Email: ${data.get('email')}\n` +
          `Company: ${data.get('company') || '-'}\n` +
          `Phone: ${data.get('phone') || '-'}\n\n` +
          `Project type: ${data.get('projectType') || '-'}\n` +
          `Detail: ${data.get('projectDetail') || '-'}\n` +
          `Stage: ${data.get('projectStage') || '-'}\n` +
          `Timeline: ${data.get('projectTimeline') || '-'}\n\n` +
          `${data.get('message') || '-'}`;
        manualBody.textContent = body;
        manual.classList.remove('hidden');
        manual.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      btn.disabled = true;
      label.textContent = isTh ? sendingText.th : sendingText.en;
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json();
        if (json.success) {
          show(ok);
          form.reset();
        } else {
          show(err);
        }
      } catch {
        show(err);
      } finally {
        btn.disabled = false;
        label.textContent = isTh ? 'ส่งข้อความ' : 'Send message';
      }
    });
  }
</script>
