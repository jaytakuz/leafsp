---
import type { Lang } from '../../i18n/utils';
import { localizePath, useTranslations } from '../../i18n/utils';
import { ROUTES, SERVICES, VALUES, PROCESS } from '../../config';
import Section from '../Section.astro';
import ServiceCard from '../ServiceCard.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const contactHref = localizePath(ROUTES.contact, lang);
const servicesHref = localizePath(ROUTES.services, lang);

const valueIcons: Record<string, string> = {
  endToEnd: 'layers',
  modern: 'zap',
  secure: 'shield',
  partnership: 'heart',
};
const processIcons: Record<string, string> = {
  discover: 'search',
  design: 'pen',
  build: 'code',
  grow: 'sprout',
};
---

<!-- ============================ HERO ============================ -->
<section class="relative overflow-hidden">
  <!-- background flourishes -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-grid absolute inset-0"></div>
    <div
      class="absolute -left-32 -top-40 h-[32rem] w-[32rem] rounded-full bg-green-200/40 blur-[120px]"
    >
    </div>
    <div
      class="absolute -right-24 top-10 h-[26rem] w-[26rem] rounded-full bg-lime-400/30 blur-[120px]"
    >
    </div>
  </div>

  <div class="container-page">
    <div
      class="grid items-center gap-12 py-16 md:grid-cols-[1.05fr_0.95fr] md:gap-10 md:py-24 lg:py-28"
    >
      <div class="reveal is-visible max-w-2xl">
        <span class="eyebrow">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-gradient"></span>
          {t.hero.eyebrow}
        </span>
        <h1
          class="mt-5 text-[2.6rem] leading-[1.08] sm:text-5xl lg:text-[3.5rem]"
        >
          {t.hero.titleLead}
          <span class="text-gradient">{t.hero.titleAccent}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-body">
          {t.hero.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href={contactHref} variant="gradient" size="lg">
            {t.cta.startProject}
          </Button>
          <Button href={servicesHref} variant="outline" size="lg" icon="arrow-right">
            {t.cta.exploreServices}
          </Button>
        </div>
        <p class="mt-7 flex items-center gap-2 text-sm text-muted">
          <Icon name="map-pin" size={16} class="text-green-600" />
          {t.hero.note}
        </p>
      </div>

      <!-- Product-window visual -->
      <div class="reveal is-visible relative mx-auto w-full max-w-md md:mx-0">
        <div
          class="rounded-3xl border border-border bg-white p-3 shadow-card"
        >
          <div class="rounded-2xl bg-surface-soft p-4">
            <!-- window chrome -->
            <div class="flex items-center gap-1.5 pb-4">
              <span class="h-2.5 w-2.5 rounded-full bg-green-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-lime-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-200"></span>
              <span
                class="ml-3 h-5 flex-1 rounded-full bg-white/70 ring-1 ring-border"
              ></span>
            </div>
            <!-- faux dashboard -->
            <div class="rounded-xl bg-white p-4 shadow-soft ring-1 ring-border">
              <div class="flex items-end justify-between">
                <div>
                  <div class="h-2 w-16 rounded-full bg-green-100"></div>
                  <div
                    class="mt-2 text-2xl font-bold text-text"
                    style="font-family:var(--font-display)"
                  >
                    99.9%
                  </div>
                </div>
                <span
                  class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-1 text-xs font-semibold text-green-700"
                >
                  <Icon name="arrow-up-right" size={12} /> +18%
                </span>
              </div>
              <!-- mini bar chart -->
              <div class="mt-4 flex h-24 items-end gap-2">
                {
                  [42, 58, 36, 70, 52, 84, 64].map((h, i) => (
                    <div
                      class="flex-1 rounded-md"
                      style={`height:${h}%;background:${
                        i === 5
                          ? 'var(--brand-gradient)'
                          : 'var(--color-green-100)'
                      }`}
                    />
                  ))
                }
              </div>
            </div>
            <!-- tiles -->
            <div class="mt-3 grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-white p-3 shadow-soft ring-1 ring-border">
                <div
                  class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-green-50 text-green-600"
                >
                  <Icon name="chip" size={16} />
                </div>
                <div class="mt-2 h-2 w-12 rounded-full bg-green-100"></div>
                <div class="mt-1.5 h-2 w-16 rounded-full bg-surface-tint"></div>
              </div>
              <div class="rounded-xl bg-white p-3 shadow-soft ring-1 ring-border">
                <div
                  class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-lime-400/20 text-green-700"
                >
                  <Icon name="shield" size={16} />
                </div>
                <div class="mt-2 h-2 w-14 rounded-full bg-green-100"></div>
                <div class="mt-1.5 h-2 w-10 rounded-full bg-surface-tint"></div>
              </div>
            </div>
          </div>
        </div>
        <!-- floating badge -->
        <div
          class="absolute -bottom-4 -left-4 hidden items-center gap-2 rounded-2xl bg-white px-4 py-3 shadow-card ring-1 ring-border sm:flex"
        >
          <span
            class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-brand-gradient text-white"
          >
            <Icon name="sparkle" size={18} />
          </span>
          <div>
            <div class="text-xs font-semibold text-text">AI-ready</div>
            <div class="text-[0.7rem] text-muted">by design</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capabilities strip -->
    <div class="border-t border-border py-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-3">
        <span
          class="text-xs font-semibold uppercase tracking-wider text-muted"
        >
          {t.capabilities.label}
        </span>
        {
          t.capabilities.items.map((c) => (
            <span
              class="rounded-full border border-border bg-white px-3.5 py-1.5 text-sm text-body"
            >
              {c}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- ========================== SERVICES ========================== -->
<Section bg="soft">
  <div class="mx-auto max-w-2xl text-center">
    <span class="eyebrow justify-center">{t.servicesSection.eyebrow}</span>
    <h2 class="mt-3 text-3xl md:text-4xl">{t.servicesSection.title}</h2>
    <p class="mt-4 text-lg text-body">{t.servicesSection.subtitle}</p>
  </div>
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      SERVICES.map((s) => (
        <ServiceCard
          icon={s.icon}
          title={t.services[s.key].title}
          desc={t.services[s.key].desc}
        />
      ))
    }
  </div>
  <div class="mt-10 text-center">
    <Button href={servicesHref} variant="outline">{t.cta.viewAllServices}</Button>
  </div>
</Section>

<!-- ========================== WHY LEAF ========================== -->
<Section bg="white">
  <div class="mx-auto max-w-2xl text-center">
    <span class="eyebrow justify-center">{t.why.eyebrow}</span>
    <h2 class="mt-3 text-3xl md:text-4xl">{t.why.title}</h2>
    <p class="mt-4 text-lg text-body">{t.why.subtitle}</p>
  </div>
  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      VALUES.map((key) => (
        <div class="reveal">
          <div
            class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-green-50 text-green-600"
          >
            <Icon name={valueIcons[key]} size={24} />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-text">
            {t.why.values[key].title}
          </h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-body">
            {t.why.values[key].desc}
          </p>
        </div>
      ))
    }
  </div>
</Section>

<!-- =========================== PROCESS =========================== -->
<Section bg="tint">
  <div class="mx-auto max-w-2xl text-center">
    <span class="eyebrow justify-center">{t.process.eyebrow}</span>
    <h2 class="mt-3 text-3xl md:text-4xl">{t.process.title}</h2>
    <p class="mt-4 text-lg text-body">{t.process.subtitle}</p>
  </div>
  <div class="relative mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    <div
      class="absolute inset-x-0 top-6 hidden h-px bg-gradient-to-r from-green-200 via-green-300 to-lime-400 lg:block"
      aria-hidden="true"
    >
    </div>
    {
      PROCESS.map((key, i) => (
        <div class="reveal relative">
          <div class="flex items-center gap-3">
            <span
              class="relative z-10 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-gradient text-white shadow-[0_10px_24px_-12px_rgba(34,163,69,0.8)]"
            >
              <Icon name={processIcons[key]} size={22} />
            </span>
            <span
              class="text-sm font-bold text-green-700"
              style="font-family:var(--font-display)"
            >
              0{i + 1}
            </span>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-text">
            {t.process.steps[key].title}
          </h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-body">
            {t.process.steps[key].desc}
          </p>
        </div>
      ))
    }
  </div>
</Section>

<!-- =========================== CTA =========================== -->
<section class="bg-surface">
  <div class="container-page pb-20 md:pb-28">
    <div
      class="relative overflow-hidden rounded-3xl bg-ink px-8 py-14 text-center md:px-16 md:py-20"
    >
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-green-500/25 blur-[90px]"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-20 -left-10 h-64 w-64 rounded-full bg-lime-500/20 blur-[90px]"
        aria-hidden="true"
      >
      </div>
      <h2 class="relative text-3xl text-white md:text-4xl">
        {t.finalCta.title}
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-lg text-[#b9c9c0]">
        {t.finalCta.subtitle}
      </p>
      <div class="relative mt-8 flex justify-center">
        <Button href={contactHref} variant="gradient" size="lg">
          {t.cta.startConversation}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgba(13, 31, 22, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(13, 31, 22, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      ellipse 80% 60% at 50% 0%,
      #000 40%,
      transparent 75%
    );
  }
</style>
