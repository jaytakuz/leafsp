---
import type { Lang } from '../../i18n/utils';
import { localizePath, useTranslations } from '../../i18n/utils';
import { ROUTES, SERVICES } from '../../config';
import Section from '../Section.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const contactHref = localizePath(ROUTES.contact, lang);
---

<!-- Page hero -->
<section class="relative overflow-hidden border-b border-border bg-surface-soft">
  <div
    class="pointer-events-none absolute -right-24 -top-28 h-96 w-96 rounded-full bg-lime-400/25 blur-[110px]"
    aria-hidden="true"
  >
  </div>
  <div class="container-page py-16 md:py-20">
    <div class="reveal is-visible mx-auto max-w-3xl text-center">
      <span class="eyebrow justify-center">{t.servicesPage.eyebrow}</span>
      <h1 class="mt-4 text-5xl md:text-6xl">{t.servicesPage.title}</h1>
      <p class="mt-5 text-base text-body md:text-[1.05rem]">{t.servicesPage.subtitle}</p>
    </div>
  </div>
</section>

<!-- Service pillars -->
<Section bg="white">
  <div class="grid gap-6 lg:grid-cols-2">
    {
      SERVICES.map((s, i) => (
        <article
          id={s.key}
          class="reveal group flex scroll-mt-28 flex-col rounded-3xl border border-border bg-surface p-7 shadow-soft transition-all duration-300 hover:border-green-200 hover:shadow-card md:p-8"
        >
          <div class="flex items-center gap-4">
            <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-gradient text-white shadow-[0_12px_28px_-14px_rgba(34,163,69,0.85)]">
              <Icon name={s.icon} size={26} />
            </span>
            <div class="flex items-baseline gap-3">
              <span
                class="text-sm font-bold text-green-200"
                style="font-family:var(--font-display)"
              >
                0{i + 1}
              </span>
              <h2 class="text-xl font-semibold text-text md:text-2xl">
                {t.services[s.key].title}
              </h2>
            </div>
          </div>
          <p class="mt-4 leading-relaxed text-body">
            {t.services[s.key].desc}
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {t.serviceTags[s.key].map((tag) => (
              <li class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-sm text-green-800">
                <Icon name="check" size={14} class="text-green-600" />
                {tag}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

<!-- Help / CTA -->
<section class="bg-surface">
  <div class="container-page pb-20 md:pb-28">
    <div
      class="flex flex-col items-center gap-6 rounded-3xl border border-border bg-surface-tint px-8 py-12 text-center md:flex-row md:justify-between md:text-left"
    >
      <div>
        <h2 class="text-2xl font-semibold text-text md:text-3xl">
          {t.servicesPage.helpTitle}
        </h2>
        <p class="mt-3 max-w-xl text-body">{t.servicesPage.helpDesc}</p>
      </div>
      <Button href={contactHref} variant="gradient" size="lg" class="shrink-0">
        {t.cta.getInTouch}
      </Button>
    </div>
  </div>
</section>
