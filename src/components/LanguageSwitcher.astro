---
import type { Lang } from '../i18n/utils';
import { localizePath, stripLocale } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = '' } = Astro.props;

const canonical = stripLocale(Astro.url.pathname);
const options: { code: Lang; label: string }[] = [
  { code: 'th', label: 'ไทย' },
  { code: 'en', label: 'EN' },
];
---

<div
  class={`inline-flex items-center rounded-full border border-border bg-white p-0.5 text-[0.8rem] font-semibold ${className}`}
  role="group"
  aria-label="Language"
>
  {
    options.map((opt) => {
      const active = opt.code === lang;
      return (
        <a
          href={localizePath(canonical, opt.code)}
          hreflang={opt.code}
          aria-current={active ? 'true' : undefined}
          class={`rounded-full px-2.5 py-1 transition-colors ${
            active
              ? 'bg-green-600 text-white'
              : 'text-muted hover:text-green-700'
          }`}
        >
          {opt.label}
        </a>
      );
    })
  }
</div>
