---
import Icon from './Icon.astro';

interface Props {
  id?: string;
  icon: string;
  title: string;
  desc: string;
}
const { id, icon, title, desc } = Astro.props;
---

<article
  id={id}
  class="reveal group relative scroll-mt-28 rounded-2xl max-sm:text-center border border-border bg-surface p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-green-200 hover:shadow-card md:p-7"
>
  <div
    class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-green-50 text-green-600"
  >
    <Icon name={icon} size={24} />
  </div>
  <h3 class="text-lg font-semibold text-text">{title}</h3>
  <p class="mt-2.5 text-[0.95rem] leading-relaxed text-body">{desc}</p>
</article>
